# GIMP gimprc
# 
# This is your personal gimprc file.  Any variable defined in this file takes
# precedence over the value defined in the system-wide gimprc: C:\Program
# Files\GIMP 3\etc\gimp\3.0\gimprc
# Most values can be set within GIMP by changing some options in the
# Preferences dialog.

(prev-language "LANGID-1033")
(config-version "3.2.4")
(font-path "C:/UnrealEngine/Games/AZ/UI Design/CHALK_HUD_v01/sources/fonts;${gimp_dir}/fonts;${gimp_data_dir}/fonts")
(import-raw-plug-in "${gimp_plug_in_dir}\\plug-ins\\file-raw-placeholder\\file-raw-placeholder.exe")
(check-update-timestamp 1788834168)
(monitor-xresolution 61)
(monitor-yresolution 61)
(fill-options
    (style fg-color)
    (custom-style solid-color)
    (antialias yes)
    (feather no)
    (feather-radius 10))
(stroke-options
    (style fg-color)
    (custom-style solid-color)
    (antialias yes)
    (feather no)
    (feather-radius 10)
    (method line)
    (width 6)
    (unit pixels)
    (cap-style butt)
    (join-style miter)
    (miter-limit 10)
    (dash-offset 0)
    (dash-info 0)
    (emulate-brush-dynamics no))


# end of gimprc
